# ─── LLM Provider ────────────────────────────────────────────────────────────
# Supported: openai, anthropic, groq, ollama, gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

# Uncomment for Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-haiku-20240307
# ANTHROPIC_API_KEY=sk-ant-...

# Uncomment for Groq (free tier)
# LLM_PROVIDER=groq
# LLM_MODEL=llama3-8b-8192
# GROQ_API_KEY=gsk_...

# ─── Email (IMAP) ────────────────────────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your@gmail.com
# Use an App Password, NOT your real account password
IMAP_PASSWORD=xxxx-xxxx-xxxx-xxxx
IMAP_FOLDER=INBOX
# Comma-separated search subjects or sender keywords to filter job alerts
EMAIL_FILTER_SUBJECTS=job alert,new jobs,jobs for you,hiring,opportunity

# ─── App Settings ────────────────────────────────────────────────────────────
DB_PATH=jobledger.db
EXPORT_DIR=exports
LOG_DIR=logs
LOG_LEVEL=INFO
# Max bytes for JD retrieval response
JD_MAX_BYTES=500000
# HTTP timeout seconds
HTTP_TIMEOUT=15
# Max retries for transient failures
MAX_RETRIES=3
