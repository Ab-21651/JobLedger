# Copy to .env and fill in. NEVER commit .env. JobLedger works without an LLM (deterministic mode)
# and refuses to pretend a mailbox exists: with no IMAP credentials use `run --fixtures PATH`.

# ---- LLM (optional). openai | anthropic | groq | gemini | ollama | none
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---- Mailbox (read-only IMAP). Gmail needs an APP PASSWORD, not your account password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
EMAIL_FILTER_SUBJECTS=job alert,new jobs,jobs for you,hiring,opportunity
EMAIL_REPLY_SUBJECTS=your application,interview,application update
EMAIL_SINCE_DAYS=30
EMAIL_MAX_MESSAGES=50

# ---- App
DB_PATH=jobledger.db
EXPORT_DIR=exports
LOG_DIR=logs
LOG_LEVEL=INFO
FOLLOWUP_WAIT_DAYS=7
